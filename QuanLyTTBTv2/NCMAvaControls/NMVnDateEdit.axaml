<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="NCMAvaControls.NMVnDateEdit">
    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Left">

        <TextBox x:Name="TxtDay"
                 PlaceholderText="dd"
                 MinWidth="30" TextAlignment="Center" VerticalContentAlignment="Center"
                 BorderThickness="0"
                 GotFocus="OnGotFocus"
                 KeyDown="OnKeyDown"
                 PointerWheelChanged="OnPointerWheelChanged" />

        <TextBlock Text="/" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold" />

        <TextBox x:Name="TxtMonth"
                 PlaceholderText="mm"
                 MinWidth="30" TextAlignment="Center" VerticalContentAlignment="Center"
                 BorderThickness="0"
                 GotFocus="OnGotFocus"
                 KeyDown="OnKeyDown"
                 PointerWheelChanged="OnPointerWheelChanged" />

        <TextBlock Text="/" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold" />

        <TextBox x:Name="TxtYear"
                 PlaceholderText="yyyy"
                 MinWidth="30" TextAlignment="Center" VerticalContentAlignment="Center"
                 BorderThickness="0"
                 GotFocus="OnGotFocus"
                 KeyDown="OnKeyDown"
                 PointerWheelChanged="OnPointerWheelChanged" />
    </StackPanel>
</UserControl>
