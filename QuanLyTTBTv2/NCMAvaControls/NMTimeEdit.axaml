<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="NCMAvaControls.NMTimeEdit" Margin="0" Padding="0" MinHeight="20">
    <UserControl.Styles>
        <StyleInclude
            Source="avares://NCMAvaControls/Styles/TextBoxStyles.axaml"/>
    </UserControl.Styles>
    <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="3" Padding="2 0">
    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Left">

        <TextBox x:Name="TxtHour" Text="00"
                 Classes="no-border"
                 MinWidth="30" MinHeight="20" Margin="0" 
                 TextAlignment="Center" VerticalContentAlignment="Center"
                 BorderThickness="0"
                 GotFocus="OnGotFocus"
                 KeyDown="OnKeyDown"
                 PointerWheelChanged="OnPointerWheelChanged" />

        <TextBlock Text=":" VerticalAlignment="Center" Margin="0" FontWeight="Bold" />

        <TextBox x:Name="TxtMinute" Text="00"
                 Classes="no-border"
                 MinWidth="30"  MinHeight="20" Margin="0"
                 TextAlignment="Center" VerticalContentAlignment="Center"
                 BorderThickness="0"
                 GotFocus="OnGotFocus"
                 KeyDown="OnKeyDown"
                 PointerWheelChanged="OnPointerWheelChanged" />

        <TextBlock Text=":" VerticalAlignment="Center" Margin="0" FontWeight="Bold" />

        <TextBox x:Name="TxtSecond" Text="00"
                 Classes="no-border"
                 MinWidth="30"  MinHeight="20" Margin="0"
                 TextAlignment="Center" VerticalContentAlignment="Center"
                 BorderThickness="0"
                 GotFocus="OnGotFocus"
                 KeyDown="OnKeyDown"
                 PointerWheelChanged="OnPointerWheelChanged" />
    </StackPanel>
    </Border>
</UserControl>
