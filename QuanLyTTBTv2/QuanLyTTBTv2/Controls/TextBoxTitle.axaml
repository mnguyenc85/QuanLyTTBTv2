<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="QuanLyTTBTv2.Controls.TextBoxTitle"
             x:Name="root">
    <StackPanel>
        <TextBlock Text="{Binding Title, ElementName=root}"
                   FontWeight="Bold"
                   Margin="0 6 0 0" />

        <TextBox Margin="6 0 2 0"
                 Text="{Binding Text, ElementName=root}"
                 PlaceholderText="{Binding PlaceholderText, ElementName=root}">

            <TextBox.InnerRightContent>
                <Button Padding="0"
                        VerticalAlignment="Stretch"
                        Width="24"
                        Click="ClearParentTextBox_Click">
                    <Image Source="{DynamicResource IconClean}"
                           Width="16"
                           Opacity="0.5" />
                </Button>
            </TextBox.InnerRightContent>

        </TextBox>
    </StackPanel>
</UserControl>
