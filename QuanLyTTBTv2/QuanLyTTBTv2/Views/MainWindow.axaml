<husk:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyTTBTv2.Views"
        xmlns:c="clr-namespace:QuanLyTTBTv2.Controls"
        xmlns:vm="using:QuanLyTTBTv2.ViewModels"
        xmlns:vmc="using:QuanLyTTBTv2.Utilities.Converters"
        xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
        xmlns:nmc="clr-namespace:NCMAvaControls;assembly=NCMAvaControls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="640"
        x:Class="QuanLyTTBTv2.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="{DynamicResource NMBg2}"
        Icon="/Assets/avalonia-logo.ico"
        Title="Quản lý trạm trộn bê tông" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        TransparencyLevelHint="Mica, None"
        Loaded="Window_OnLoaded" Closed="Window_OnClosed">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <husk:AppWindow.Resources>
        <vmc:NullToBoolConverter x:Key="Null2BoolCvt"/>
    </husk:AppWindow.Resources>

    
    <LayoutTransformControl>
        <DockPanel>
            <Border DockPanel.Dock="Top">
                <!-- Menu -->
                <Grid ColumnDefinitions="*,Auto">
                    <Menu>
                        <MenuItem Header="Hệ thống">
                            <MenuItem x:Name="MniSysConfig" Header="Cài đặt..." Click="MniSysConfig_OnClick" />
                            <Separator />
                            <MenuItem x:Name="MniSysExit" Header="Thoát" Click="MniSysExit_OnClick" />
                        </MenuItem>
                        <MenuItem Header="Công cụ">
                            <MenuItem x:Name="MniToolsDonHang" Header="Đơn hàng">
                                <MenuItem x:Name="MniToolsDHTk1" Header="Thống kê đơn chọn" Click="MniToolsDHTk1_OnClick"/>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleSwitch Margin="0 0 12 0"
                                      OnContent="Dark" OffContent="Light"
                                      Click="OnSwitchThemeClick"
                                      ToolTip.Tip="Toggle Light / Dark" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Background="{DynamicResource NMStatusBg}">
                <StackPanel Orientation="Horizontal" Margin="3 6">
                    <TextBlock Text="Server: " Foreground="DimGray" />
                    <TextBlock Text="{Binding SrvStatus}" Foreground="Black"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="6 6 3 6">
                    <TextBlock Text="{Binding LastAction}" Foreground="Black"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="3 6">
                    <TextBlock Text="TG thực hiện: " Foreground="DimGray" />
                    <TextBlock Text="{Binding LastExecTime}" Foreground="Black"/>
                </StackPanel>
            </StackPanel>

            <DockPanel Background="{DynamicResource NMBg1}">
            <DockPanel DockPanel.Dock="Top" Margin="9 6 3 3">
                <TextBlock Text="Trạm: " VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" VerticalAlignment="Stretch"
                        Classes="cbo-right-btn" Height="32" ToolTip.Tip="Làm mới">
                    <Image Source="../Assets/refresh.png" Width="16" Height="16" Opacity="0.5" />
                </Button>
                <ComboBox HorizontalAlignment="Stretch" CornerRadius="3 0 0 3" Height="32"
                          ItemsSource="{Binding Workspace.SrvFactories}"
                          DisplayMemberBinding="{Binding Ten}" SelectedItem="{Binding Workspace.SelFactory}" />
            </DockPanel>
            
            <TabControl x:Name="TabMain" Padding="6" 
                        SelectionChanged="TabMain_OnSelectionChanged">
                <!-- Đơn hàng -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconTabCongTrinh" Source="../Assets/congtrinh_1_64.png" Width="24"
                                   Margin="0 0 6 0" />
                            <TextBlock Text="Đơn hàng" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <local:CtlDsDonHang DataContext="{Binding CtlDonHangVM}"/>
                </TabItem>

                <!-- Phiếu -->
                <TabItem IsEnabled="{Binding Workspace.SelectedDonHang, Converter={StaticResource Null2BoolCvt}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconTabPhieu" Source="../Assets/concrete_truck_2_64.png" Width="24"
                                   Margin="0 0 6 0" />
                            <TextBlock Text="Phiếu trộn" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <local:CtlDsPhieu x:Name="CtlDsPh" DataContext="{Binding CtlPhieuVM}"/>
                </TabItem>
                
                <!-- Phiếu đã in -->
                <TabItem IsEnabled="{Binding Workspace.SelectedPhieu, Converter={StaticResource Null2BoolCvt}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="IconTabPhieuIn" Source="../Assets/printed_document_64.png" Width="24"
                                   Margin="0 0 6 0" />
                            <TextBlock Text="Phiếu in" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    
                    <local:CtlDsPhieuIn DataContext="{Binding CtlInPhieuVM}"/>
                </TabItem>
            </TabControl>
            </DockPanel>
                
        </DockPanel>
    </LayoutTransformControl>
</husk:AppWindow>