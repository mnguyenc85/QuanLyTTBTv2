<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuanLyTTBTv2.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="QuanLyTTBTv2.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="{DynamicResource NMBackgroundBrush}"
        Icon="/Assets/avalonia-logo.ico" FontFamily="Times New Roman"
        Title="Quản lý trạm trộn bê tông" WindowStartupLocation="CenterScreen" WindowState="Maximized" 
        Loaded="Window_OnLoaded" Closed="Window_OnClosed">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Border BorderBrush="LightGray" BorderThickness="0 0 0 1" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*,Auto">
                <Menu>
                    <MenuItem Header="Hệ thống">
                        <MenuItem x:Name="MniSysConfig" Header="Cài đặt..." Click="MniSysConfig_OnClick"/>
                        <Separator/>
                        <MenuItem x:Name="MniSysExit" Header="Thoát" Click="MniSysExit_OnClick"/>
                    </MenuItem>
                </Menu>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleSwitch Margin="0 0 12 0"
                                  OnContent="Dark" OffContent="Light"
                                  Click="OnSwitchThemeClick"
                                  ToolTip.Tip="Toggle Light / Dark" />
                </StackPanel>
            </Grid>
        </Border>
        
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"  Background="{DynamicResource NMStatusbarBrush}">
            <StackPanel Orientation="Horizontal" Margin="3">
                <TextBlock Text="Server: " Foreground="DimGray"/>
                <TextBlock Text="{Binding SrvStatus}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="3">
                <TextBlock Text="TG thực hiện thời: " Foreground="DimGray"/>
                <TextBlock Text="{Binding LastExecTime}"/>
            </StackPanel>
        </StackPanel>
        
        <DockPanel DockPanel.Dock="Top" Margin="9 6 3 3">
            <TextBlock Text="Trạm: " VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" VerticalAlignment="Stretch"
                    Classes="cbo-right-btn" Height="32" ToolTip.Tip="Làm mới">
                <Image Source="../Assets/refresh.png" Width="16" Height="16" Opacity="0.5"/>
            </Button>
            <ComboBox HorizontalAlignment="Stretch" CornerRadius="3 0 0 3" Height="32"
                      ItemsSource="{Binding Workspace.SrvFactories}"
                      DisplayMemberBinding="{Binding Ten}" SelectedItem="{Binding Workspace.SelFactory}"/>
        </DockPanel>
        <TabControl>
            <!-- Công trình -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="IconTabCongTrinh" Source="../Assets/congtrinh_1_64.png" Width="24" Margin="0 0 6 0"/>
                        <TextBlock Text="Đơn hàng" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid ColumnDefinitions="252,6,*">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Thời gian" FontWeight="Bold"/>
                        <StackPanel Margin="6 0 0 0">
                            <CheckBox Content="Từ" Margin="0 3"/>
                            <StackPanel Orientation="Horizontal">
                                <CalendarDatePicker Margin="0 0 3 0" MinWidth="120" Width="120"
                                                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                                    PlaceholderText="dd/MM/yyyy"/>
                                <TimePicker MinWidth="120" VerticalAlignment="Stretch"/>
                            </StackPanel>
                            <CheckBox Content="Đến" Margin="0 3"/>
                            <StackPanel Orientation="Horizontal">
                                <CalendarDatePicker Margin="0 0 3 0" MinWidth="120" Width="120"
                                                    SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy"
                                                    PlaceholderText="dd/MM/yyyy"/>
                                <TimePicker MinWidth="120" VerticalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <TextBlock Text="Khách hàng" FontWeight="Bold" Margin="0 6 0 0"/>
                        <TextBox PlaceholderText="Khách hàng / sđt" Margin="6 0 2 0">
                            <TextBox.InnerRightContent>
                                <Button Padding="0" VerticalAlignment="Stretch" Width="24"
                                        Click="ClearParentTextBox_Click">
                                    <!-- <Image Source="../Assets/clear_64.png" Width="16" Opacity="0.5"/> -->
                                    <Image Source="{DynamicResource IconClean}" Width="16" Opacity="0.5"/>
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        
                        <TextBlock Text="Công trình" FontWeight="Bold" Margin="0 6 0 0"/>
                        <TextBox PlaceholderText="Dự án / công trình / hạng mục" Margin="6 0 2 0">
                            <TextBox.InnerRightContent>
                                <Button Padding="0" VerticalAlignment="Stretch" Width="24"
                                        Click="ClearParentTextBox_Click">
                                    <Image Source="{DynamicResource IconClean}" Width="16" Opacity="0.5"/>
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0 12 0 0" Classes="Primary"
                                Content="Tìm kiếm" />
                    </StackPanel>

                    <ListBox Grid.Column="2">
                        
                    </ListBox>
                </Grid>
            </TabItem>
            
            <!-- Phiếu -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="IconTabPhieu" Source="../Assets/docket_1_64.png" Width="24" Margin="0 0 6 0"/>
                        <TextBlock Text="Phiếu trộn" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid ColumnDefinitions="180,3,*">
                    <GridSplitter Grid.Column="1"/>
                    
                    <ListBox Grid.Column="2"></ListBox>
                </Grid>
            </TabItem>
            
            <!-- Mẻ -->
            <TabItem Header="Mẻ cân" FontSize="16">
                <StackPanel>
                    
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
